{{!
    @template block_greeting/content

    Content for the greeting block.

    Context variables required for this template:
    * message - The greeting text to display.

    Example context (json):
    {
        "message": "Hello, Alice!"
    }
}}
<div class="block_greeting" aria-label="{{#str}}pluginname, block_greeting{{/str}}">
    <p class="block_greeting__message" aria-live="polite">{{message}}</p>
</div>
